# Credenciales de acceso de la aplicación.
# Copie este archivo como .env y complete los valores en su máquina.
# El archivo .env NO se sube al repositorio.
ADMIN_CORREO=
ADMIN_CLAVE=
USUARIO_CORREO=
USUARIO_CLAVE=

# Clave secreta de Flask para firmar las sesiones.
# Use un valor largo y aleatorio; en Vercel se configura como variable de entorno.
SECRET_KEY=

# Conexión opcional a Supabase/PostgreSQL.
# Si está vacía, la app usa el respaldo local SQLite (academia.db).
DATABASE_URL=
